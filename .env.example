# PostgreSQL local — escolha UMA opcao:

# Opcao A: pgAdmin / PostgreSQL instalado (recomendado)
DATABASE_URL="postgresql://vitalis:vitalis@localhost:5432/vitalis?schema=public"

# Opcao B: superuser postgres (dev rapido)
# DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/vitalis?schema=public"

# Opcao C: Docker Compose (pnpm db:up) — porta 5432 ou 5433 se conflitar
# DATABASE_URL="postgresql://vitalis:vitalis@localhost:5432/vitalis?schema=public"

# Producao Azure (depois) — ver docs/HOSPEDAGEM.md
# DATABASE_URL="postgresql://USUARIO:SENHA@vitalis-db.postgres.database.azure.com:5432/vitalis?sslmode=require"

# API
PORT=3333
NODE_ENV=development
JWT_SECRET="troque-por-uma-chave-segura-com-pelo-menos-32-caracteres"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS - separar origens por virgula em producao
CORS_ORIGINS="*"

# Admin - use header X-Admin-Key ou usuario com role ADMIN
ADMIN_API_KEY="sua-chave-admin-secreta"

# Servico Python ML (obrigatorio para classificacao real)
ML_SERVICE_URL="http://localhost:8000"
ML_SERVICE_TIMEOUT_MS=5000

# Google Gemini — explicacao em linguagem natural (opcional)
# Obtenha em: https://aistudio.google.com/apikey
# GEMINI_API_KEY="AIza..."
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_ENABLED=false

# Web
NEXT_PUBLIC_API_URL="http://localhost:3333"
