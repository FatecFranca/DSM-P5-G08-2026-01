# PostgreSQL local (Docker)
DATABASE_URL="postgresql://vitalis:vitalis@localhost:5432/vitalis?schema=public"

# API
PORT=3333
NODE_ENV=development
JWT_SECRET="troque-por-uma-chave-segura-com-pelo-menos-32-caracteres"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS - separar origens por virgula em producao
CORS_ORIGINS="*"

# Admin - use header X-Admin-Key ou usuario com role ADMIN
ADMIN_API_KEY="sua-chave-admin-secreta"

# Servico Python ML (opcional)
# ML_SERVICE_URL="http://localhost:8000"
ML_SERVICE_TIMEOUT_MS=5000

# Web
NEXT_PUBLIC_API_URL="http://localhost:3333"
