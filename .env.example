# =============================================================================
# Vitalis — variáveis de ambiente
# Copie: cp .env.example .env
# =============================================================================

# --- Banco de dados ---

# Local (pgAdmin / Docker)
DATABASE_URL="postgresql://vitalis:vitalis@localhost:5432/vitalis?schema=public"

# VM Azure (API nativa na VM — Postgres no Docker interno)
# DATABASE_URL="postgresql://vitalis:vitalis@localhost:5432/vitalis?schema=public"

# --- API ---

PORT=3333
NODE_ENV=development

# URL pública no Swagger UI (/docs)
# API_PUBLIC_URL="http://4.229.233.225:3333"

JWT_SECRET="troque-por-uma-chave-segura-com-pelo-menos-32-caracteres"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS — em producao liste origens separadas por virgula
CORS_ORIGINS="*"

ADMIN_API_KEY="sua-chave-admin-secreta"

# --- ML (Python FastAPI) ---

# Local
ML_SERVICE_URL="http://localhost:8000"

# VM (API no host apontando para ML no Docker)
# ML_SERVICE_URL="http://localhost:8000"

ML_SERVICE_TIMEOUT_MS=5000

# --- Google Gemini (opcional) ---

# Obtenha em: https://aistudio.google.com/apikey
# GEMINI_API_KEY="AIza..."
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_ENABLED=false

# --- Web (Next.js) ---

NEXT_PUBLIC_API_URL="http://localhost:3333"

# --- Mobile Flutter ---

# URL padrao compilada no app: http://4.229.233.225:3333
# Sobrescrever no run:
#   flutter run --dart-define=API_URL=http://10.0.2.2:3333
# Emulador Android local: http://10.0.2.2:3333
# Aparelho fisico + API local: http://IP_DA_MAQUINA:3333
# Producao PI (VM): http://4.229.233.225:3333

# --- VM Azure (referencia) ---

# IP publico: 4.229.233.225
# Porta API: 3333 (NSG — regra Vitalis-API)
# SSH: MerlinTroll@4.229.233.225
# Ver: docs/HOSPEDAGEM-VM.md
